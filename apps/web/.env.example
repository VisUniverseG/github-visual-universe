# Placeholders only. Copy to `apps/web/.env` (git-ignored) for local overrides.
# Only variables prefixed with VITE_ are embedded in the public bundle, so NEVER
# put a secret here. The web app never holds a GitHub client secret.

# Base URL of the API, as seen from the browser.
VITE_API_BASE_URL=http://localhost:8787

# Public path the site is served from. "/" locally;
# "/github-visual-universe/" when built for GitHub Pages.
VITE_BASE_PATH=/
