# Placeholders only. Copy to `apps/web/.env` (git-ignored) for local overrides.
# Only variables prefixed with VITE_ are embedded in the public bundle, so NEVER
# put a secret here. The web app never holds a GitHub client secret.

# Base URL of the API, as seen from the browser.
VITE_API_BASE_URL=http://localhost:8787

# Public path the site is served from. "/" locally;
# "/github-visual-universe/" when built for GitHub Pages.
VITE_BASE_PATH=/

# Public Client ID of the GitHub App (Settings -> Developer settings -> GitHub Apps).
# It is an identifier, not a secret. Leave empty and the page shows sign-in as not configured.
VITE_GITHUB_APP_CLIENT_ID=

# The EXACT callback URI registered on the GitHub App. Used verbatim (never derived or normalized)
# and must also be listed in the API's ALLOWED_REDIRECT_URIS.
#   local:      http://localhost:5173/auth/callback
#   production: https://visuniverseg.github.io/github-visual-universe/auth/callback/
# Defaults to the local value in development; a production build must set it explicitly.
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
