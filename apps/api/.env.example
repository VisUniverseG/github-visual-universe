# Placeholders only. Copy to `apps/api/.env` (git-ignored) for local overrides.
# NEVER commit real values. Authentication is not implemented yet.

# Port to listen on. Render injects PORT automatically in production.
PORT=8787

# Interface to bind. Use 127.0.0.1 locally. On Render set HOST=0.0.0.0.
HOST=127.0.0.1

# Comma-separated exact browser origins allowed by CORS. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reserved for the auth-broker phase (leave unset until then; see docs/adr/0001):
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
