# Placeholders only. Copy to `apps/api/.env` (git-ignored) for local overrides.
# NEVER commit real values. The client secret belongs ONLY here (server-side).

# Port to listen on. Render injects PORT automatically in production.
PORT=8787

# Interface to bind. Use 127.0.0.1 locally. On Render set HOST=0.0.0.0.
HOST=127.0.0.1

# Comma-separated exact browser origins allowed by CORS. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GitHub App credentials for the auth broker (POST /auth/token, POST /auth/revoke).
# Both are optional: the API starts without them and /auth/* answers a generic 503.
# The Client ID is public. The Client Secret is a secret: set it only in your private,
# git-ignored `.env` (or the host's secret store), never in a file that is committed.
# Restart the API after changing these; `tsx watch` does not reload on .env changes.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Comma-separated EXACT callback URIs the broker will accept. Each entry must already be in
# canonical form (it is compared as an exact string; nothing is normalized). No wildcards.
# Local default shown. Production (added when deploying):
#   https://visuniverseg.github.io/github-visual-universe/auth/callback/
ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback
