{
  "name": "@gvu/api",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Hono API. Will become the stateless GitHub auth broker (see ADR 0001).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "dependencies": {
    "@gvu/shared": "0.0.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
